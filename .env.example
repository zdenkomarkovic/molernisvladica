# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash)
NEXT_PUBLIC_SITE_URL=https://molerajnis.rs

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=Colorium

# Google Search Console verifikacija (token iz content atributa meta taga)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Mailjet (kontakt forma)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SITE_MAIL_SENDER=
SITE_MAIL_RECEIVER=coolorium@gmail.com

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Database (opciono, prilagodi po potrebi)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Auth secret (opciono - ako koristis NextAuth/Lucia)
# AUTH_SECRET=
